  font-weight: 720;
}

.zpres-theme-sv .zpres-slide.zpres-slide-class-sv-evidence-native[data-slide-variant="figure"] .zpres-diagram-edge-label {
  fill: var(--sv-muted);
  font-size: var(--text-slide-micro);
  transform: translateY(-42px);
}

.zpres-theme-sv .zpres-slide.zpres-slide-class-sv-evidence-native[data-slide-variant="figure"] .zpres-slide-primary > .zpres-block-paragraph {
  width: 100%;
  padding: var(--spacing-slide-2) var(--spacing-slide-4);
  border-inline-start: 5px double var(--sv-muted);
  color: var(--sv-text);
  background: var(--sv-panel);
  font-family: {{param.font_mono}};
  font-size: var(--text-slide-technical);
  line-height: var(--text-slide-technical--line-height);
}

/* Imported paper evidence keeps its white field when that field carries
 * meaning, but the frame and adjacent authored caption make the surface
 * deliberate in Dark rather than an unexplained island. */
.zpres-theme-sv .zpres-slide.zpres-slide-class-sv-evidence-imported[data-slide-variant="figure"] .zpres-slide-header {
  max-width: none;
}

.zpres-theme-sv .zpres-slide.zpres-slide-class-sv-evidence-imported[data-slide-variant="figure"] .zpres-block-figure {
  grid-template-rows: minmax(0, 1fr) max-content;
  gap: var(--spacing-slide-4);
}

.zpres-theme-sv .zpres-slide.zpres-slide-class-sv-evidence-imported[data-slide-variant="figure"] .zpres-block-figure img {
  box-sizing: border-box;
  min-height: 0;
  padding: var(--spacing-slide-2);
  border: 2px solid var(--sv-muted);
  border-radius: 0;
  background: var(--sv-evidence-paper);
  box-shadow: 8px 8px 0 color-mix(in srgb, var(--sv-rule) 46%, transparent);
}

.zpres-theme-sv .zpres-slide.zpres-slide-class-sv-evidence-imported[data-slide-variant="figure"] .zpres-block-figure figcaption {
  box-sizing: border-box;
  width: 100%;
  padding: var(--spacing-slide-2) var(--spacing-slide-4);
  border-inline-start: 5px double var(--sv-muted);
  color: var(--sv-text);
  background: color-mix(in srgb, var(--sv-rule) 10%, var(--sv-surface));
  font-size: var(--text-slide-technical);
  line-height: var(--text-slide-technical--line-height);
}

.zpres-theme-sv .zpres-slide[data-slide-variant="figure"] .zpres-slide-header {
  max-width: 52rem;
}

.zpres-theme-sv .zpres-slide[data-slide-variant="dense"] .zpres-slide-header {
  padding-block-end: var(--spacing-slide-2);
  border-block-end-color: var(--sv-rule);
}

.zpres-theme-sv .zpres-slide[data-slide-variant="dense"] :where(.zpres-block-code, .zpres-block-math, .zpres-block-table) {
  padding: 4px var(--spacing-slide-2);
  border-color: var(--sv-rule);
}

.zpres-theme-sv .zpres-slide[data-slide-variant="dense"] .zpres-slide-primary {
  gap: var(--spacing-slide-2);
}

.zpres-theme-sv .zpres-slide[data-slide-variant="dense"] .zpres-block-table :where(th, td) {
  padding: 4px var(--spacing-slide-2);
}

.zpres-theme-sv .zpres-slide[data-slide-variant="dense"] :where(.zpres-block-paragraph, .zpres-block-list) {
  font-size: var(--text-slide-technical);
  line-height: 1.2;
}

/* A short authored advisor trace is a distinct Detail evidence job, not a
 * generic Dense layout or another solver state. The code field owns the body;
 * the authored pacing explanation stays in its own lower band. */
.zpres-theme-sv .zpres-slide.zpres-slide-class-sv-evidence-inspectable-trace[data-slide-role="detail"] .zpres-slide-body {
  align-items: stretch;
}

.zpres-theme-sv .zpres-slide.zpres-slide-class-sv-evidence-inspectable-trace[data-slide-role="detail"] .zpres-slide-primary {
  height: 100%;
  grid-template-rows: minmax(0, 1fr) max-content;
  align-content: stretch;
  gap: var(--spacing-slide-6);
}

.zpres-theme-sv .zpres-slide.zpres-slide-class-sv-evidence-inspectable-trace[data-slide-role="detail"] .zpres-block-code {
  display: grid;
  min-height: 0;
  height: 100%;
  align-content: stretch;
  padding: var(--spacing-slide-6) var(--spacing-slide-8);
  border: 2px solid var(--sv-rule);
  border-radius: 0;
  font-size: var(--text-slide-body);
  line-height: 1.35;
  box-shadow: inset 0 7px 0 var(--sv-rule);
}

.zpres-theme-sv .zpres-slide.zpres-slide-class-sv-evidence-inspectable-trace[data-slide-role="detail"] .zpres-block-code pre {
  display: grid;
  min-height: 0;
  height: 100%;
  align-content: center;
  padding-block: var(--spacing-slide-6);
}

.zpres-theme-sv .zpres-slide.zpres-slide-class-sv-evidence-inspectable-trace[data-slide-role="detail"] .zpres-slide-primary > .zpres-block-paragraph {
  padding: var(--spacing-slide-4) var(--spacing-slide-6);
  border-block: 2px solid var(--sv-rule);
  border-inline-start: 6px double var(--sv-muted);
  background: var(--sv-panel);
  font-size: var(--text-slide-technical);
  line-height: var(--text-slide-technical--line-height);
}

.zpres-theme-sv .zpres-slide[data-slide-role="detail"]:not(:is(
  .zpres-slide-class-sv-state-queued,
  .zpres-slide-class-sv-state-active,
  .zpres-slide-class-sv-state-fixed,
  .zpres-slide-class-sv-state-failed,
  .zpres-slide-class-sv-state-trace
)) .zpres-slide-frame::before {
  background: var(--sv-rule);
}

.zpres-theme-sv .zpres-slide[data-slide-role="detail"] .zpres-slide-title {
  font-size: var(--text-slide-title);
}

@media (prefers-contrast: more) {
  .zpres-theme-sv .zpres-slide-frame {
    background: var(--sv-surface);
  }
}

@media (forced-colors: active) {
  .zpres-theme-sv .zpres-slide:is(
    .zpres-slide-class-sv-evidence-domain-update,
    .zpres-slide-class-sv-evidence-causal-schedule
  )[data-slide-variant="comparison"] .zpres-layout-regions::after {
    border-color: CanvasText;
    color: CanvasText;
    background: Canvas;
    forced-color-adjust: auto;
  }

  .zpres-theme-sv .zpres-slide.zpres-slide-class-sv-evidence-domain-update[data-slide-variant="comparison"] .zpres-block-fit-text::before,
  .zpres-theme-sv .zpres-slide.zpres-slide-class-sv-evidence-domain-update[data-slide-variant="comparison"] .zpres-block-fit-text::after {
    background: CanvasText;
    forced-color-adjust: auto;
  }

  .zpres-theme-sv .zpres-slide-frame::before,
  .zpres-theme-sv .zpres-slide-frame::after {
    border-color: CanvasText;
    background: CanvasText;
  }

  .zpres-theme-sv .zpres-slide:is(
    .zpres-slide-class-sv-state-queued,
    .zpres-slide-class-sv-state-active,
    .zpres-slide-class-sv-state-fixed,
    .zpres-slide-class-sv-state-failed,
    .zpres-slide-class-sv-state-trace
  ) .zpres-slide-frame::before {
    color: CanvasText;
    border-color: CanvasText;
    background: Canvas;
    forced-color-adjust: auto;
  }

  .zpres-theme-sv .zpres-slide:is(
    .zpres-slide-class-sv-state-queued,
    .zpres-slide-class-sv-state-active,
    .zpres-slide-class-sv-state-fixed,
    .zpres-slide-class-sv-state-failed,
    .zpres-slide-class-sv-state-trace
  ) .zpres-slide-frame::after {
    color: Highlight;
    border: 0;
    background: transparent;
    text-shadow: none;
    forced-color-adjust: auto;
  }
}
