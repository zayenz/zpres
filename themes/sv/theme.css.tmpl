.zpres-theme-sv {
  --sv-background: {{param.background}};
  --sv-surface: {{param.surface}};
  --sv-text: {{param.text}};
  --sv-muted: {{param.muted}};
  --sv-accent: {{param.accent}};
  --sv-accent-alt: {{param.accent_alt}};
  --sv-rule: {{param.rule}};
  --sv-current: var(--sv-accent);
  --sv-outcome: var(--sv-accent-alt);
  --sv-plot: color-mix(in srgb, var(--sv-surface) 92%, var(--sv-background));
  --sv-panel: color-mix(in srgb, var(--sv-rule) 12%, var(--sv-surface));
  --sv-code-background: #11161b;
  --sv-code-text: #f1f5f2;
  --sv-grid: color-mix(in srgb, var(--sv-rule) 42%, transparent);
  --sv-state-rail-block-start: 218px;
  --sv-state-rail-inline-start: 28px;
  --sv-state-rail-width: 240px;
  --sv-state-row: 52px;
  --sv-evidence-transition: 7rem;
  --sv-evidence-paper: #ffffff;
  --zpres-data-primary-measure: none;
  --zpres-data-claim-measure: 64rem;
  --zpres-data-claim-inset: var(--spacing-slide-8);
  --zpres-data-dense-measure: none;
  --zpres-data-figure-max-block: 456px;
  color: var(--sv-text);
  background: var(--sv-background);
  font-family: {{param.font_body}};
}

/*
 * Shared Theme API v1 components inherit their generic accent role. Inside an
 * SV Slide that role is neutral: violet and gold are available only through
 * the authored current/outcome hooks below. The muted role keeps the shared
 * 3px focus outline visible in both palettes without spending state colour.
 */
.zpres-theme-sv .zpres-slide {
  --zpres-color-accent: var(--sv-muted);
  --zpres-color-accent-alt: var(--sv-rule);
}

.zpres-theme-sv :where(a, .zpres-footnote-ref) {
  color: var(--sv-text);
}

.zpres-theme-sv .zpres-diagram-surface,
.zpres-theme-sv .zpres-diagram-node rect,
.zpres-theme-sv .zpres-diagram-edge {
  stroke: var(--sv-muted);
}

.zpres-theme-sv .zpres-diagram-arrow {
  fill: var(--sv-muted);
}

.zpres-theme-sv :where(.zpres-chart-mark, .zpres-chart-line, .zpres-chart-point) {
  color: var(--sv-muted);
}

.zpres-theme-sv .zpres-slide.zpres-slide-class-sv-causal-trace :where(.zpres-diagram-surface, .zpres-diagram-node rect, .zpres-diagram-edge) {
  stroke: var(--sv-current);
}

.zpres-theme-sv .zpres-slide.zpres-slide-class-sv-causal-trace .zpres-diagram-arrow {
  fill: var(--sv-current);
}

.zpres-theme-sv .zpres-slide.zpres-slide-class-sv-causal-trace :where(.zpres-chart-mark, .zpres-chart-line, .zpres-chart-point) {
  color: var(--sv-current);
}

.zpres-theme-sv .zpres-slide-frame {
  position: relative;
  color: var(--sv-text);
  background:
    linear-gradient(90deg, var(--sv-grid) 1px, transparent 1px),
    linear-gradient(0deg, var(--sv-grid) 1px, transparent 1px),
    var(--sv-surface);
  background-size: 112px 112px;
  box-shadow:
    0 20px 54px rgb(17 22 27 / 0.14),
    inset 0 0 0 1px var(--sv-rule);
}

.zpres-theme-sv .zpres-slide-frame::before {
  content: "";
  position: absolute;
  inset-block: 0;
  inset-inline-start: 0;
  width: 2px;
  pointer-events: none;
  background: var(--sv-rule);
}

.zpres-theme-sv .zpres-slide-frame::after {
  content: "";
  position: absolute;
  inset-block-start: 28px;
  inset-inline-end: 32px;
  width: 30px;
  height: 18px;
  pointer-events: none;
  border-block-start: 2px solid var(--sv-rule);
  border-inline-end: 2px solid var(--sv-rule);
}

/*
 * Authored propagation state. The four rows never move: marker shape,
 * fill/outline, line style, label, and position all remain available without
 * colour. Two full mono spaces separate marker, line, and label.
 */
.zpres-theme-sv .zpres-slide.zpres-slide-class-sv-state-queued,
.zpres-theme-sv .zpres-slide.zpres-slide-class-sv-state-trace {
  --sv-state-current-offset: 0px;
  --sv-state-current-label: "◇  - -  QUEUED";
  --sv-state-current-ink: var(--sv-text);
  --sv-state-current-shadow: none;
}

.zpres-theme-sv .zpres-slide.zpres-slide-class-sv-state-active {
  --sv-state-current-offset: var(--sv-state-row);
  --sv-state-current-label: "▶  ━━  ACTIVE";
  --sv-state-current-ink: var(--sv-current);
  --sv-state-current-shadow: 0 0 14px color-mix(in srgb, var(--sv-current) 42%, transparent);
}

.zpres-theme-sv .zpres-slide.zpres-slide-class-sv-state-fixed {
  --sv-state-current-offset: calc(var(--sv-state-row) * 2);
  --sv-state-current-label: "■  ==  FIXED";
  --sv-state-current-ink: color-mix(in srgb, var(--sv-outcome) 88%, var(--sv-text));
  --sv-state-current-shadow: none;
}

.zpres-theme-sv .zpres-slide.zpres-slide-class-sv-state-failed {
  --sv-state-current-offset: calc(var(--sv-state-row) * 3);
  --sv-state-current-label: "×  · ·  FAILED";
  --sv-state-current-ink: color-mix(in srgb, var(--sv-outcome) 88%, var(--sv-text));
  --sv-state-current-shadow: none;
}

.zpres-theme-sv .zpres-slide.zpres-slide-class-sv-state-trace:has(.zpres-layout-region[data-derivation-role="stage"][data-step-index="1"][data-step-state="active"]) {
  --sv-state-current-offset: var(--sv-state-row);
  --sv-state-current-label: "▶  ━━  ACTIVE";
  --sv-state-current-ink: var(--sv-current);
  --sv-state-current-shadow: 0 0 14px color-mix(in srgb, var(--sv-current) 42%, transparent);
}

.zpres-theme-sv .zpres-slide.zpres-slide-class-sv-state-trace:has(.zpres-layout-region[data-derivation-role="stage"][data-step-index="2"]:is([data-step-state="active"], [data-step-state="complete"])) {
  --sv-state-current-offset: calc(var(--sv-state-row) * 2);
  --sv-state-current-label: "■  ==  FIXED";
  --sv-state-current-ink: color-mix(in srgb, var(--sv-outcome) 88%, var(--sv-text));
  --sv-state-current-shadow: none;
}

.zpres-theme-sv .zpres-slide:is(
  .zpres-slide-class-sv-state-queued,
  .zpres-slide-class-sv-state-active,
  .zpres-slide-class-sv-state-fixed,
  .zpres-slide-class-sv-state-failed,
  .zpres-slide-class-sv-state-trace
) .zpres-slide-frame {
  padding-inline-start: 304px;
}

.zpres-theme-sv .zpres-slide:is(
  .zpres-slide-class-sv-state-queued,
  .zpres-slide-class-sv-state-active,
  .zpres-slide-class-sv-state-fixed,
  .zpres-slide-class-sv-state-failed,
  .zpres-slide-class-sv-state-trace
) .zpres-slide-frame::before {
  content: "◇  - -  QUEUED\A▶  ━━  ACTIVE\A■  ==  FIXED\A×  · ·  FAILED";
  position: absolute;
  inset: auto;
  inset-block-start: var(--sv-state-rail-block-start);
  inset-inline-start: var(--sv-state-rail-inline-start);
  width: var(--sv-state-rail-width);
  height: calc((var(--sv-state-row) * 4) + 36px);
  padding: 18px 16px;
  border-block: 1px solid var(--sv-rule);
  border-inline-end: 1px solid var(--sv-rule);
  color: var(--sv-muted);
  background: color-mix(in srgb, var(--sv-rule) 8%, var(--sv-surface));
  font-family: {{param.font_mono}};
  font-size: var(--text-slide-technical);
  font-weight: 720;
  letter-spacing: 0;
  line-height: var(--sv-state-row);
  white-space: pre;
}

.zpres-theme-sv .zpres-slide:is(
  .zpres-slide-class-sv-state-queued,
  .zpres-slide-class-sv-state-active,
  .zpres-slide-class-sv-state-fixed,
  .zpres-slide-class-sv-state-failed,
  .zpres-slide-class-sv-state-trace
) .zpres-slide-frame::after {
  content: var(--sv-state-current-label);
  position: absolute;
  inset: auto;
  inset-block-start: calc(var(--sv-state-rail-block-start) + 18px + var(--sv-state-current-offset));
  inset-inline-start: calc(var(--sv-state-rail-inline-start) + 16px);
  width: calc(var(--sv-state-rail-width) - 32px);
  height: var(--sv-state-row);
  border: 0;
  color: var(--sv-state-current-ink);
  background: transparent;
  font-family: {{param.font_mono}};
  font-size: var(--text-slide-technical);
  font-weight: 860;
  letter-spacing: 0;
  line-height: var(--sv-state-row);
  text-shadow: var(--sv-state-current-shadow);
  white-space: pre;
}

.zpres-theme-sv .zpres-slide-header {
  padding-block-end: var(--spacing-slide-4);
  border-block-end: 2px solid var(--sv-rule);
}

.zpres-theme-sv .zpres-slide-title {
  max-width: 28ch;
  color: var(--sv-text);
  font-family: {{param.font_heading}};
  font-size: 2.75rem;
  font-weight: 760;
  letter-spacing: 0.005em;
  line-height: 0.98;
  text-wrap: balance;
}

.zpres-theme-sv :where(.zpres-slide-body, .zpres-slide-primary) {
  color: var(--sv-text);
  font-family: {{param.font_body}};
}

.zpres-theme-sv :where(.zpres-block-code, .zpres-block-math, .zpres-block-table),
.zpres-theme-sv :where(.zpres-layout-region-title, figcaption, .zpres-slide-sources, .zpres-slide-footer) {
  font-family: {{param.font_mono}};
}

.zpres-theme-sv .zpres-slide-sources,
.zpres-theme-sv .zpres-slide-footer {
  color: var(--sv-muted);
  border-color: var(--sv-rule);
}

.zpres-theme-sv .zpres-slide-footer-number {
  color: var(--sv-muted);
  font-weight: 800;
}

.zpres-theme-sv .debug-diagnostics {
  display: none !important;
}

.zpres-theme-sv .zpres-block-code pre {
  color: var(--sv-code-text);
  background: var(--sv-code-background);
  box-shadow: inset 0 5px 0 var(--sv-rule);
}

/* Stable capture is part of the Theme contract; reveal pacing must not flash
 * a compositor-sized code background between authored Steps. */
.zpres-theme-sv :where(
  .zpres-code-line.fragment,
  .zpres-slide-class-sv-state-trace .zpres-layout-region.fragment
) {
  transition: none;
}

.zpres-theme-sv .zpres-block-math {
  border-color: var(--sv-rule);
  border-radius: 3px;
  background: var(--sv-panel);
  box-shadow: inset 5px 0 0 var(--sv-rule);
}

.zpres-theme-sv .zpres-block-table {
  border-radius: 3px;
  background: var(--sv-plot);
}

.zpres-theme-sv .zpres-block-table thead th {
  color: var(--sv-text);
  border-color: var(--sv-rule);
  font-size: var(--text-slide-technical);
  letter-spacing: 0.045em;
  text-transform: uppercase;
}

.zpres-theme-sv .zpres-block-table tbody tr:has(strong) {
  background: color-mix(in srgb, var(--sv-rule) 24%, transparent);
  box-shadow: inset 5px 0 0 var(--sv-rule);
}

.zpres-theme-sv .zpres-block-table tbody tr:has(strong) strong {
  color: var(--sv-text);
}

.zpres-theme-sv .zpres-block-table tbody tr:nth-child(even):not(:has(strong)) {
  background: color-mix(in srgb, var(--sv-rule) 20%, transparent);
}

.zpres-theme-sv :where(.zpres-block-figure, .zpres-block-chart, .zpres-block-diagram, .zpres-block-gallery, .zpres-block-media) {
  position: relative;
}

.zpres-theme-sv :where(.zpres-block-figure img, .zpres-chart-svg, .zpres-diagram-svg, .zpres-gallery-item img, .zpres-block-media :where(img, video)) {
  border: 1px solid var(--sv-rule);
  border-radius: 3px;
  background:
    linear-gradient(90deg, var(--sv-grid) 1px, transparent 1px),
    linear-gradient(0deg, var(--sv-grid) 1px, transparent 1px),
    var(--sv-plot);
  background-size: 48px 48px;
  box-shadow: 8px 8px 0 color-mix(in srgb, var(--sv-rule) 36%, transparent);
}

.zpres-theme-sv :where(.zpres-block-figure figcaption, .zpres-block-gallery figcaption, .zpres-block-media figcaption) {
  color: var(--sv-muted);
  font-size: var(--text-slide-technical);
  letter-spacing: 0.015em;
}

.zpres-theme-sv :where(.zpres-chart-axis-label, .zpres-chart-legend, .zpres-chart-annotation) {
  color: var(--sv-text);
  font-family: {{param.font_mono}};
}

.zpres-theme-sv .zpres-slide[data-slide-variant="section-title"] .zpres-slide-content {
  align-content: center;
  grid-template-rows: max-content max-content max-content;
  gap: var(--spacing-slide-8);
}

.zpres-theme-sv .zpres-slide[data-slide-variant="section-title"] .zpres-slide-header {
  max-width: 68rem;
  padding-block-end: var(--spacing-slide-8);
  border-block-end: 7px solid var(--sv-text);
}

.zpres-theme-sv .zpres-slide[data-slide-variant="section-title"] .zpres-slide-title {
  max-width: 22ch;
  font-size: 3.5rem;
  letter-spacing: 0.015em;
  text-transform: uppercase;
}

.zpres-theme-sv .zpres-slide[data-slide-variant="section-title"] .zpres-slide-body {
  align-items: start;
  margin-block-start: var(--spacing-slide-8);
}

.zpres-theme-sv .zpres-slide[data-slide-variant="section-title"] .zpres-slide-primary {
  align-content: start;
}

.zpres-theme-sv .zpres-slide[data-slide-variant="claim"] .zpres-slide-primary {
  position: relative;
  display: grid;
  grid-template-columns: minmax(0, 0.92fr) minmax(0, 1.08fr);
  column-gap: var(--spacing-slide-8);
  row-gap: var(--spacing-slide-4);
  padding-block: var(--spacing-slide-4);
  border-block: 2px solid var(--sv-rule);
  border-inline-start: 8px solid var(--sv-text);
  background: color-mix(in srgb, var(--sv-rule) 12%, transparent);
}

.zpres-theme-sv .zpres-slide[data-slide-variant="claim"] .zpres-slide-primary:has(> .zpres-block-layout) > .zpres-block-fit-text {
  grid-column: 1;
  grid-row: 1;
}

.zpres-theme-sv .zpres-slide[data-slide-variant="claim"] .zpres-slide-primary:has(> .zpres-block-layout) > .zpres-block-math {
  grid-column: 1;
  grid-row: 2;
}

.zpres-theme-sv .zpres-slide[data-slide-variant="claim"] .zpres-slide-primary:has(> .zpres-block-layout) > .zpres-block-layout {
  grid-column: 2;
  grid-row: 1 / span 2;
  align-self: center;
}

.zpres-theme-sv .zpres-slide[data-slide-variant="claim"] .zpres-slide-primary:has(> .zpres-block-layout) .zpres-layout-region :where(p, li) {
  font-size: var(--text-slide-technical);
  line-height: var(--text-slide-technical--line-height);
}

.zpres-theme-sv .zpres-slide[data-slide-variant="claim"] .zpres-slide-primary:not(:has(> .zpres-block-layout)) > .zpres-block-fit-text {
  grid-column: 1 / -1;
}

.zpres-theme-sv .zpres-slide[data-slide-variant="claim"] .zpres-slide-primary:not(:has(> .zpres-block-layout)) :where(.zpres-block-list, .zpres-block-quote) {
  font-size: var(--text-slide-technical);
  line-height: var(--text-slide-technical--line-height);
}

.zpres-theme-sv .zpres-slide[data-slide-variant="claim"] .zpres-block-fit-text p,
.zpres-theme-sv .zpres-slide[data-slide-variant="claim"] .zpres-block-paragraph:first-child {
  color: var(--sv-text);
  font-family: {{param.font_heading}};
  font-weight: 760;
}

.zpres-theme-sv .zpres-slide[data-slide-variant="claim"] .zpres-block-fit-text {
  min-height: 0;
}

.zpres-theme-sv .zpres-slide[data-slide-variant="claim"] .zpres-block-fit-text p {
  max-width: 36ch;
  font-size: 2.75rem;
  line-height: 1.04;
}

.zpres-theme-sv .zpres-slide[data-slide-variant="claim"] .zpres-slide-primary:has(> .zpres-block-layout) .zpres-block-fit-text p {
  font-size: 2.6rem;
}

.zpres-theme-sv .zpres-slide[data-slide-variant="comparison"] .zpres-layout-region[data-comparison-role] {
  padding: var(--spacing-slide-4);
  border-color: var(--sv-rule);
  border-radius: 3px;
  background: var(--sv-plot);
  box-shadow: inset 0 5px 0 var(--sv-rule);
}

.zpres-theme-sv .zpres-slide[data-slide-variant="comparison"] .zpres-layout-region[data-comparison-role="supporting"] {
  box-shadow: inset 0 5px 0 var(--sv-muted);
}

.zpres-theme-sv .zpres-slide[data-slide-variant="comparison"] .zpres-layout-region-title {
  gap: var(--spacing-slide-4);
}

.zpres-theme-sv .zpres-slide[data-slide-variant="comparison"] .zpres-layout-region :where(p, li) {
  font-size: var(--text-slide-technical);
  line-height: var(--text-slide-technical--line-height);
}

.zpres-theme-sv .zpres-slide[data-slide-variant="comparison"] .zpres-block-quote blockquote {
  padding: var(--spacing-slide-2) var(--spacing-slide-4);
}

.zpres-theme-sv .zpres-slide[data-slide-variant="comparison"] .zpres-block-quote p {
  max-width: none;
  font-size: var(--text-slide-technical);
  line-height: 1.22;
}

.zpres-theme-sv .zpres-slide[data-slide-variant="comparison"] .zpres-layout-region-title,
.zpres-theme-sv .zpres-slide[data-slide-variant="derivation"] .zpres-layout-region-title {
  color: var(--sv-text);
  letter-spacing: 0.055em;
  text-transform: uppercase;
}

/*
 * Propagation-native evidence is explicit Source intent. These hooks compose
 * stable renderer roles; they do not infer semantics from block order. Domain
 * and schedule Comparisons share one baseline instead of becoming two cards.
 */
.zpres-theme-sv .zpres-slide:is(
  .zpres-slide-class-sv-evidence-domain-update,
  .zpres-slide-class-sv-evidence-causal-schedule
)[data-slide-variant="comparison"] .zpres-slide-header {
  max-width: none;
}

.zpres-theme-sv .zpres-slide:is(
  .zpres-slide-class-sv-evidence-domain-update,
  .zpres-slide-class-sv-evidence-causal-schedule
)[data-slide-variant="comparison"] .zpres-slide-title {
  max-width: 34ch;
}

.zpres-theme-sv .zpres-slide:is(
  .zpres-slide-class-sv-evidence-domain-update,
  .zpres-slide-class-sv-evidence-causal-schedule
)[data-slide-variant="comparison"] :where(.zpres-slide-body, .zpres-slide-primary, .zpres-block-layout) {
  min-height: 0;
  height: 100%;
}

.zpres-theme-sv .zpres-slide:is(
  .zpres-slide-class-sv-evidence-domain-update,
  .zpres-slide-class-sv-evidence-causal-schedule
)[data-slide-variant="comparison"] .zpres-slide-primary {
  grid-template-rows: minmax(0, 1fr) max-content;
  align-content: stretch;
  gap: var(--spacing-slide-4);
}

.zpres-theme-sv .zpres-slide:is(
  .zpres-slide-class-sv-evidence-domain-update,
  .zpres-slide-class-sv-evidence-causal-schedule
)[data-slide-variant="comparison"] .zpres-layout-regions {
  position: relative;
  height: 100%;
  gap: calc(var(--sv-evidence-transition) + var(--spacing-slide-4)) !important;
}

.zpres-theme-sv .zpres-slide:is(
  .zpres-slide-class-sv-evidence-domain-update,
  .zpres-slide-class-sv-evidence-causal-schedule
)[data-slide-variant="comparison"] .zpres-layout-regions::after {
  content: "→";
  position: absolute;
  z-index: 2;
  inset-block-start: 50%;
  inset-inline-start: 50%;
  box-sizing: border-box;
  width: var(--sv-evidence-transition);
  padding: var(--spacing-slide-2) var(--spacing-slide-4);
  transform: translate(-50%, -50%);
  border-block: 2px solid var(--sv-rule);
  color: var(--sv-muted);
  background: var(--sv-surface);
  font-family: {{param.font_mono}};
  font-size: var(--text-slide-technical);
  font-weight: 820;
  letter-spacing: 0.035em;
  line-height: var(--text-slide-micro--line-height);
  text-align: center;
  white-space: nowrap;
}

.zpres-theme-sv .zpres-slide:is(
  .zpres-slide-class-sv-evidence-domain-update,
  .zpres-slide-class-sv-evidence-causal-schedule
).zpres-slide-class-sv-causal-trace[data-slide-variant="comparison"] .zpres-layout-regions::after {
  border-color: var(--sv-current);
  color: var(--sv-current);
}

.zpres-theme-sv .zpres-slide:is(
  .zpres-slide-class-sv-evidence-domain-update,
  .zpres-slide-class-sv-evidence-causal-schedule
)[data-slide-variant="comparison"] .zpres-layout-region[data-comparison-role] {
  padding: var(--spacing-slide-6);
  border: 0;
  border-block: 2px solid var(--sv-rule);
  border-radius: 0;
  background: transparent;
  box-shadow: none;
}

.zpres-theme-sv .zpres-slide:is(
  .zpres-slide-class-sv-evidence-domain-update,
  .zpres-slide-class-sv-evidence-causal-schedule
)[data-slide-variant="comparison"] .zpres-layout-region[data-comparison-role="supporting"] {
  box-shadow: none;
}

.zpres-theme-sv .zpres-slide:is(
  .zpres-slide-class-sv-evidence-domain-update,
  .zpres-slide-class-sv-evidence-causal-schedule
)[data-slide-variant="comparison"] .zpres-layout-region-content {
  align-content: center;
}

.zpres-theme-sv .zpres-slide:is(
  .zpres-slide-class-sv-evidence-domain-update,
  .zpres-slide-class-sv-evidence-causal-schedule
)[data-slide-variant="comparison"] .zpres-block-quote blockquote {
  padding: var(--spacing-slide-2) var(--spacing-slide-6);
  border-inline-start-width: 6px;
  border-inline-start-color: var(--sv-rule);
  background: color-mix(in srgb, var(--sv-rule) 8%, transparent);
}

.zpres-theme-sv .zpres-slide:is(
  .zpres-slide-class-sv-evidence-domain-update,
  .zpres-slide-class-sv-evidence-causal-schedule
).zpres-slide-class-sv-causal-trace[data-slide-variant="comparison"] .zpres-block-quote blockquote {
  border-inline-start-color: var(--sv-current);
}

.zpres-theme-sv .zpres-slide:is(
  .zpres-slide-class-sv-evidence-domain-update,
  .zpres-slide-class-sv-evidence-causal-schedule
