.zpres-print-slide {
  color: var(--zpres-color-text, #17211f);
  background: var(--zpres-color-background, #edf1ee);
}

.zpres-print-slide .zpres-slide-body {
  font-family: var(--zpres-font-body, "Avenir Next", Aptos, "Segoe UI", sans-serif);
}

.zpres-print-slide .zpres-slide-frame {
  background: var(--zpres-color-surface, #fffdf8);
  box-shadow:
    inset 10px 0 0 var(--zpres-color-accent, #0a6c67),
    inset 0 0 0 1px var(--zpres-color-rule, #ccd5ce);
}

.zpres-print-slide .zpres-slide-header {
  border-block-end-color: var(--zpres-color-rule, #ccd5ce);
}

.zpres-print-slide .zpres-slide-title,
.zpres-print-slide .zpres-slide-body,
.zpres-print-slide .zpres-slide-primary {
  color: var(--zpres-color-text, #17211f);
}

.zpres-print-slide .zpres-slide-sources,
.zpres-print-slide .zpres-slide-footer {
  color: var(--zpres-color-muted, #586a64);
}

.zpres-print-slide :where(.zpres-block-code, .zpres-block-math, .zpres-block-table, .zpres-layout-region-title, figcaption, .zpres-slide-sources, .zpres-slide-footer, .zpres-detail-indicator) {
  font-family: var(--zpres-font-mono, Menlo, Consolas, monospace);
}

.zpres-print-slide .zpres-slide-footer-number {
  color: var(--zpres-color-accent, #0a6c67);
}

.zpres-print-slide .zpres-detail-indicator,
.zpres-print-slide .zpres-layout-region-title {
  color: color-mix(in srgb, var(--zpres-color-text, #17211f) 72%, var(--zpres-color-accent-alt, #b67828));
}

.zpres-print-slide[data-slide-variant="claim"] .zpres-slide-primary {
  padding-inline-start: var(--spacing-slide-4);
  border-inline-start: 3px solid color-mix(in srgb, var(--zpres-color-accent-alt, #b67828) 72%, var(--zpres-color-accent, #0a6c67));
}

.zpres-print-slide[data-slide-variant="comparison"] .zpres-layout-region[data-comparison-role],
.zpres-print-slide[data-slide-variant="derivation"] .zpres-layout-region[data-derivation-role] {
  background: color-mix(in srgb, var(--zpres-color-surface, #fffdf8) 90%, var(--zpres-color-background, #edf1ee));
  border-radius: 0.85rem;
  box-shadow: inset 0 0 0 1px var(--zpres-color-rule, #ccd5ce);
}

.zpres-print-slide[data-slide-variant="figure"] .zpres-block-figure img {
  max-height: 25rem;
  width: auto;
  margin-inline: auto;
}

.zpres-print-slide[data-slide-variant="comparison"] [data-comparison-role="primary"],
.zpres-print-slide[data-slide-variant="derivation"] .zpres-layout-region[data-derivation-role="context"] {
  box-shadow:
    inset 0 0 0 1px var(--zpres-color-rule, #ccd5ce),
    inset 5px 0 0 var(--zpres-color-accent, #0a6c67);
}

.zpres-print-slide[data-slide-variant="derivation"] .zpres-layout-region[data-derivation-role] {
  grid-template-columns: minmax(12rem, 0.32fr) minmax(0, 1fr);
  align-items: center;
  gap: var(--spacing-slide-4);
  padding: var(--spacing-slide-2) var(--spacing-slide-4);
}

.zpres-print-slide[data-slide-variant="derivation"] .zpres-layout-region-title {
  display: flex;
  align-items: center;
  min-width: 0;
  line-height: 1.15;
  white-space: nowrap;
}

.zpres-print-slide[data-slide-variant="comparison"] [data-comparison-role="supporting"] {
  box-shadow:
    inset 0 0 0 1px var(--zpres-color-rule, #ccd5ce),
    inset 5px 0 0 color-mix(in srgb, var(--zpres-color-accent-alt, #b67828) 64%, var(--zpres-color-accent, #0a6c67));
}

.zpres-print-slide[data-slide-variant="comparison"] .zpres-layout-region-title {
  column-gap: var(--spacing-slide-2);
}

.zpres-print-slide[data-slide-variant="comparison"] .zpres-layout-region-title::before {
  margin-inline-end: var(--spacing-slide-2);
}

.zpres-print-slide[data-slide-variant="derivation"] .zpres-layout-region[data-derivation-role="stage"][data-step-state="active"] {
  border-color: color-mix(in srgb, var(--zpres-color-accent-alt, #b67828) 68%, var(--zpres-color-accent, #0a6c67));
  box-shadow:
    inset 0 0 0 2px color-mix(in srgb, var(--zpres-color-accent-alt, #b67828) 68%, var(--zpres-color-accent, #0a6c67)),
    inset 5px 0 0 var(--zpres-color-accent, #0a6c67);
}

.zpres-print-slide .zpres-step:is([data-step-state], [data-zpres-print-step-state]) {
  padding-inline-start: var(--spacing-slide-4);
  border-inline-start: 3px solid var(--zpres-color-rule, #ccd5ce);
}

.zpres-print-slide .zpres-step:is([data-step-state="active"], [data-zpres-print-step-state="active"]) {
  border-inline-start-color: var(--zpres-color-accent, #0a6c67);
}

.zpres-print-slide[data-slide-variant="dense"] :where(.zpres-block-paragraph, .zpres-block-list, .zpres-block-table, .zpres-block-code, .zpres-block-math) {
  font-size: var(--text-slide-technical);
  line-height: 1.18;
}

.zpres-print-slide[data-slide-variant="dense"] .zpres-layout-regions {
  align-items: stretch !important;
}

.zpres-print-slide[data-slide-variant="dense"] .zpres-layout-region {
  align-content: start;
  gap: var(--spacing-slide-2);
  padding: var(--spacing-slide-4);
  background: color-mix(in srgb, var(--zpres-color-surface, #fffdf8) 92%, var(--zpres-color-background, #edf1ee));
  border: 1px solid var(--zpres-color-rule, #ccd5ce);
  border-radius: 0.75rem;
}

.zpres-print-slide[data-slide-variant="dense"] .zpres-layout-region-title {
  color: color-mix(in srgb, var(--zpres-color-text, #17211f) 76%, var(--zpres-color-accent-alt, #b67828));
  font-size: var(--text-slide-technical);
  font-weight: 700;
}

.zpres-print-slide[data-slide-variant="dense"] :where(.zpres-block-code, .zpres-block-math, .zpres-block-table) {
  padding: 0;
  background: color-mix(in srgb, var(--zpres-color-surface, #fffdf8) 88%, var(--zpres-color-background, #edf1ee));
  border-radius: 0.5rem;
}

.zpres-print-slide[data-slide-variant="dense"] .zpres-block-table table {
  width: 100%;
  border-collapse: separate;
  border-spacing: 0;
}

.zpres-print-slide[data-slide-variant="dense"] .zpres-block-table :where(th, td) {
  padding: 0.42rem 0.7rem;
}

.zpres-print-slide[data-slide-variant="dense"] .zpres-block-table :where(th:nth-child(2), th:nth-child(3), td:nth-child(2), td:nth-child(3)) {
  white-space: nowrap;
}

.zpres-print-slide[data-slide-variant="dense"] .zpres-block-code pre {
  margin: 0;
  padding: 0.8rem 1rem;
  border-radius: 0.5rem;
}

.zpres-print-slide[data-slide-variant="dense"] .zpres-block-code[data-code-line-numbers="false"] .zpres-code-line-number {
  display: none;
}

.zpres-print-slide[data-slide-variant="dense"] .zpres-block-code[data-code-line-numbers="false"] .zpres-code-line {
  display: block;
}

.zpres-print-slide[data-slide-variant="dense"] .zpres-code-line-text {
  white-space: pre-wrap;
  overflow-wrap: anywhere;
}

.zpres-print-slide[data-slide-variant="dense"] .zpres-block-math {
  display: grid;
  min-height: 5rem;
  place-items: center;
  padding: var(--spacing-slide-4);
  color: var(--zpres-color-text, #17211f);
  background: color-mix(in srgb, var(--zpres-color-accent, #0a6c67) 8%, var(--zpres-color-surface, #fffdf8));
  border: 1px solid var(--zpres-color-rule, #ccd5ce);
}
