.zpres-theme-wedding .zpres-slide[data-slide-variant="derivation"] .zpres-layout-region-title::before { flex: 0 0 auto; margin-inline-end: var(--spacing-slide-2); }
.zpres-theme-wedding .zpres-slide[data-slide-variant="derivation"] .zpres-slide-primary:has(> .zpres-block-figure) { padding-block-start: var(--spacing-slide-4); }
.zpres-theme-wedding .zpres-slide[data-slide-variant="derivation"] .zpres-block-figure img { max-block-size: 18rem !important; }
