/* Renderer-owned backgrounds remain visible. Split images reserve their lane; full images receive a quiet surface scrim. */
.zpres-theme-wedding .zpres-slide:has(> .zpres-slide-background):not([data-background-split]) .zpres-slide-frame { background: color-mix(in srgb, var(--wedding-surface) 88%, transparent); backdrop-filter: blur(1px); }
.zpres-theme-wedding .zpres-slide[data-background-split] .zpres-slide-frame { background: var(--wedding-surface); }

/* The stage stays still while the invitation sheet changes. Steps on one sheet never use these states. */
.zpres-theme-wedding .zpres-slide.is-entering,
.zpres-theme-wedding .zpres-slide.is-leaving { background: transparent; }
.zpres-theme-wedding .zpres-slide:is(.is-entering, .is-leaving) > .zpres-slide-frame {
  background-color: var(--wedding-stock-active) !important;
  backdrop-filter: none;
  -webkit-backdrop-filter: none;
}
.zpres-theme-wedding .zpres-slide.is-leaving:not([data-zpres-transition-direction="backward"]):not(.zpres-background-splash-slide) > .zpres-slide-background,
.zpres-theme-wedding .zpres-slide.is-entering[data-zpres-transition-direction="backward"]:not(.zpres-background-splash-slide) > .zpres-slide-background { opacity: 0; }
.zpres-theme-wedding .zpres-slide.is-leaving { z-index: 4; }
.zpres-theme-wedding .zpres-slide.is-entering { z-index: 3; }
.zpres-theme-wedding .zpres-slide.is-leaving > .zpres-slide-frame { animation: wedding-sheet-leave-forward 500ms cubic-bezier(.4,0,.2,1) both; }
.zpres-theme-wedding .zpres-slide.is-leaving::before,
.zpres-theme-wedding .zpres-slide.is-leaving::after { display: none; }
.zpres-theme-wedding .zpres-slide.is-entering > .zpres-slide-frame { animation: none; }
.zpres-theme-wedding .zpres-slide.is-leaving[data-zpres-transition-direction="backward"] { z-index: 3; }
.zpres-theme-wedding .zpres-slide.is-entering[data-zpres-transition-direction="backward"] { z-index: 5; }
.zpres-theme-wedding .zpres-slide.is-leaving[data-zpres-transition-direction="backward"] > .zpres-slide-frame { animation: wedding-sheet-stay-backward 500ms linear both; }
.zpres-theme-wedding .zpres-slide.is-leaving[data-zpres-transition-direction="backward"]::before,
.zpres-theme-wedding .zpres-slide.is-leaving[data-zpres-transition-direction="backward"]::after { display: block; animation: wedding-sheet-stay-backward 500ms linear both; }
.zpres-theme-wedding .zpres-slide.is-entering[data-zpres-transition-direction="backward"] > .zpres-slide-frame { animation: wedding-sheet-enter-backward 500ms cubic-bezier(.4,0,.2,1) both; }
.zpres-theme-wedding .zpres-slide.is-entering[data-zpres-transition-direction="backward"]::before,
.zpres-theme-wedding .zpres-slide.is-entering[data-zpres-transition-direction="backward"]::after { display: none; }

/* The generated opening beat reveals the untreated room, then returns the complete folio. */
.zpres-theme-wedding:has(.zpres-background-splash-slide.is-entering) .zpres-slide.is-leaving > .zpres-slide-background { opacity: 0; }
.zpres-theme-wedding:has(.zpres-background-splash-slide.is-entering) .zpres-slide.is-leaving > .zpres-slide-frame,
.zpres-theme-wedding:has(.zpres-background-splash-slide.is-entering) .zpres-slide.is-leaving::before,
.zpres-theme-wedding:has(.zpres-background-splash-slide.is-entering) .zpres-slide.is-leaving::after { animation: wedding-sheet-leave-forward 500ms cubic-bezier(.4,0,.2,1) both; }
.zpres-theme-wedding:has(.zpres-background-splash-slide.is-entering) .zpres-slide.is-leaving::before,
.zpres-theme-wedding:has(.zpres-background-splash-slide.is-entering) .zpres-slide.is-leaving::after { display: block; }
.zpres-theme-wedding:has(.zpres-background-splash-slide.is-leaving) .zpres-background-splash-slide.is-leaving { z-index: 2; }
.zpres-theme-wedding:has(.zpres-background-splash-slide.is-leaving) .zpres-slide.is-entering { z-index: 5; }
.zpres-theme-wedding:has(.zpres-background-splash-slide.is-leaving) .zpres-slide.is-entering > .zpres-slide-frame,
.zpres-theme-wedding:has(.zpres-background-splash-slide.is-leaving) .zpres-slide.is-entering::before,
.zpres-theme-wedding:has(.zpres-background-splash-slide.is-leaving) .zpres-slide.is-entering::after { animation: wedding-pile-enter 500ms cubic-bezier(.4,0,.2,1) both; }
.zpres-theme-wedding:has(.zpres-background-splash-slide.is-leaving) .zpres-slide.is-entering::before,
.zpres-theme-wedding:has(.zpres-background-splash-slide.is-leaving) .zpres-slide.is-entering::after { display: block; }
@keyframes wedding-sheet-leave-forward {
  from { transform: translate(0, 0) rotate(0); box-shadow: var(--wedding-elevation-resting); }
  to { transform: translate(-1320px, -96px) rotate(-5deg); box-shadow: var(--wedding-elevation-lifted); }
}
@keyframes wedding-sheet-stay-backward {
  from, to { transform: translate(0, 0) rotate(0); box-shadow: var(--wedding-elevation-resting); }
}
@keyframes wedding-sheet-enter-backward {
  from { transform: translate(-1320px, -96px) rotate(-5deg); box-shadow: var(--wedding-elevation-lifted); }
  to { transform: translate(0, 0) rotate(0); box-shadow: var(--wedding-elevation-resting); }
}
@keyframes wedding-pile-enter {
  from { transform: translate(-1320px, -96px) rotate(-5deg); box-shadow: var(--wedding-elevation-lifted); }
  to { transform: translate(0, 0) rotate(0); box-shadow: var(--wedding-elevation-resting); }
}

/* The visible stock counts down with the final three Sections: three, two, one. */
.zpres-theme-wedding .zpres-section-stack:nth-last-child(2) .zpres-slide::after,
.zpres-theme-wedding .zpres-print-slide:nth-last-child(2)::after { display: none; }
.zpres-theme-wedding .zpres-section-stack:last-child .zpres-slide::before,
.zpres-theme-wedding .zpres-section-stack:last-child .zpres-slide::after,
.zpres-theme-wedding .zpres-print-slide:last-child::before,
.zpres-theme-wedding .zpres-print-slide:last-child::after { display: none; }

@media (prefers-reduced-motion: reduce) {
  .zpres-theme-wedding .zpres-slide:is(.is-entering, .is-leaving) > .zpres-slide-frame {
    animation: none !important;
    transform: none !important;
    box-shadow: var(--wedding-elevation-resting);
  }
  .zpres-theme-wedding .zpres-slide:is(.is-entering, .is-leaving)::before,
  .zpres-theme-wedding .zpres-slide:is(.is-entering, .is-leaving)::after { animation: none !important; transform: none !important; }
}

@media (forced-colors: active) { .zpres-theme-wedding .zpres-slide-ornament::before, .zpres-theme-wedding .zpres-slide-ornament::after { background: CanvasText; } }
