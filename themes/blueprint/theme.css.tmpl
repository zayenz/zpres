/* Shared geometry, type sizes, scientific blocks, and accessibility states
   come from Theme API v1 and its scientific-data module. */
.zpres-theme-blueprint {
  --zpres-data-primary-measure: none;
  color: var(--zpres-color-text);
  background: var(--zpres-color-background);
  font-family: var(--zpres-font-body);
}
.zpres-theme-blueprint .zpres-slide-frame {
  background: var(--zpres-color-surface);
}
.zpres-theme-blueprint .zpres-slide-title {
  font-family: var(--zpres-font-heading);
  max-width: none;
  letter-spacing: -0.025em;
}
.zpres-theme-blueprint .zpres-slide-header {
  padding-block-end: var(--spacing-slide-4);
}
.zpres-theme-blueprint .zpres-slide[data-slide-variant="section-title"] .zpres-slide-title {
  max-width: 22ch;
  font-size: var(--text-slide-display);
}
.zpres-theme-blueprint .zpres-slide[data-slide-variant="section-title"] .zpres-slide-header {
  align-self: end;
}
.zpres-theme-blueprint .zpres-slide[data-slide-variant="section-title"] .zpres-slide-content {
  grid-template-rows: minmax(min-content, 1fr) minmax(0, 1fr) min-content;
}
.zpres-theme-blueprint .zpres-slide[data-slide-variant="section-title"] .zpres-slide-body {
  align-items: start;
}
.zpres-theme-blueprint .zpres-slide[data-slide-variant="section-title"] .zpres-slide-primary {
  align-content: start;
}
.zpres-theme-blueprint :where(.zpres-slide-footer, .zpres-slide-sources, figcaption) {
  color: var(--zpres-color-muted);
}
.zpres-theme-blueprint .zpres-slide-footer-number {
  color: var(--zpres-color-accent);
  font-weight: 700;
}
.zpres-theme-blueprint .zpres-layout-region-title {
  column-gap: var(--spacing-slide-4);
}
.zpres-theme-blueprint .zpres-block-code pre {
  color: var(--zpres-color-text);
  background: var(--zpres-color-surface);
}
.zpres-theme-blueprint .zpres-slide[data-slide-role="detail"] .zpres-detail-indicator {
  color: var(--zpres-color-accent-alt);
}
.zpres-theme-blueprint .zpres-slide:is([data-background-phase="content"], [data-background-phase="title"]) > .zpres-slide-frame {
  background-color: color-mix(in srgb, var(--zpres-color-surface) 94%, transparent);
}
/* Authored backgrounds keep the renderer's treatment and split semantics. */
.zpres-theme-blueprint .zpres-slide[data-background-phase] > .zpres-slide-ornament {
  display: none;
}
@media (forced-colors: active) {
  .zpres-theme-blueprint .zpres-slide-ornament { display: none; }
}
/* Drafting registration is outside the safe area; no grid crosses prose. */
.zpres-theme-blueprint .zpres-slide-title { font-weight: 700; letter-spacing: 0; }
.zpres-theme-blueprint .zpres-slide-ornament::before {
  content: ""; position: absolute; inset: 20px 24px;
  border-block: 3px double var(--zpres-color-rule);
  border-inline: 1px solid var(--zpres-color-rule);
}
.zpres-theme-blueprint .zpres-slide-ornament::after {
  content: ""; position: absolute; inset: 12px 36px;
  background: repeating-linear-gradient(90deg, var(--zpres-color-accent) 0 1px, transparent 1px 120px) top / 100% 16px no-repeat,
    repeating-linear-gradient(90deg, var(--zpres-color-accent) 0 1px, transparent 1px 120px) bottom / 100% 16px no-repeat;
}
.zpres-theme-blueprint :where(.zpres-slide-footer, .zpres-layout-region-title, .zpres-detail-indicator) { font-family: var(--zpres-font-mono); }
.zpres-theme-blueprint .zpres-slide-header { border-block-end: 3px double var(--zpres-color-rule); }
.zpres-theme-blueprint :where(.zpres-block-code, .zpres-block-math, .zpres-block-table, .zpres-layout-region[data-comparison-role]) { border-radius: 0; }
.zpres-theme-blueprint .zpres-layout-region[data-comparison-role="supporting"] { border-style: dashed; }

.zpres-theme-blueprint :where(.zpres-block-code, .zpres-block-math, .zpres-block-table) {
  border-color: var(--zpres-color-rule);
}
.zpres-theme-blueprint .zpres-block-code pre {
  font-family: var(--zpres-font-mono);
}

.zpres-theme-blueprint .zpres-block-figure figcaption {
  font-size: var(--text-slide-technical);
}

/* Diagram strokes must remain meaningful on both light and dark surfaces. */
.zpres-theme-blueprint :where(.zpres-diagram-surface, .zpres-diagram-node rect, .zpres-diagram-edge) {
  stroke: var(--zpres-color-accent);
}
.zpres-theme-blueprint .zpres-diagram-arrow { fill: var(--zpres-color-accent); }
/* Keep stage labels beside their evidence and leave a full spacing step
   between the cue and its text, including long labels. */
.zpres-theme-blueprint .zpres-layout-region[data-derivation-role] {
  grid-template-columns: minmax(18rem, 0.36fr) minmax(0, 1fr);
  gap: var(--spacing-slide-2) var(--spacing-slide-5);
  padding-block: var(--spacing-slide-3);
}
.zpres-theme-blueprint .zpres-layout-region[data-derivation-role] > .zpres-block {
  grid-column: 2;
}
.zpres-theme-blueprint .zpres-layout-region[data-derivation-role] .zpres-layout-region-title {
  display: flex;
  align-items: center;
  letter-spacing: 0;
}
.zpres-theme-blueprint .zpres-layout-region[data-derivation-role] .zpres-layout-region-title::before {
  flex: none;
  margin-inline-end: 0;
}
.zpres-theme-blueprint .zpres-layout-region[data-derivation-role] :where(.zpres-block-code, .zpres-block-math) {
  padding: var(--spacing-slide-2) var(--spacing-slide-4);
}

.zpres-theme-blueprint .zpres-slide[data-slide-variant="dense"] :where(.zpres-block-paragraph, .zpres-block-list) {
  font-size: var(--text-slide-technical);
  line-height: var(--text-slide-technical--line-height);
}

/* Explicit slide colors also apply to the content surface and secondary ink.
   Explicit surface/muted parameters remain authoritative through inline vars. */
.zpres-theme-blueprint .zpres-slide[data-theme-param-background] {
  --zpres-color-surface: var(--zpres-color-background);
}
.zpres-theme-blueprint .zpres-slide[data-theme-param-text] {
  --zpres-color-muted: var(--zpres-color-text);
}
.zpres-theme-blueprint .zpres-slide[data-theme-param-text] .zpres-slide-footer-number {
  color: var(--zpres-color-text);
}
