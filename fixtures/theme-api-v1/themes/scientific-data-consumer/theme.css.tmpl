.zpres-theme-scientific-data-consumer {
  color: {{param.text}};
  background: {{param.background}};
}

.zpres-theme-scientific-data-consumer .zpres-slide-frame {
  color: {{param.text}};
  background: {{param.surface}};
}

.zpres-theme-scientific-data-consumer :where(.zpres-slide-header, .zpres-slide-title, .zpres-slide-body, .zpres-slide-primary, .zpres-slide-sources, .zpres-slide-footer) {
  color: inherit;
}

.zpres-theme-scientific-data-consumer :where(.zpres-slide-frame, .zpres-block) {
  border-color: {{param.rule}};
}
